# ==========================================
# PostgreSQL Configuration
# ==========================================
# Pydantic Settings: Maps to DatabaseSettings
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==========================================
# MinIO Configuration (Object Storage)
# ==========================================
# Pydantic Settings: Maps to MinIOSettings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=document-storage
MINIO_SECURE=false  # ← Now validated as boolean

# ==========================================
# App Settings
# ==========================================
ENV=development  # ← Literal["development", "staging", "production"]
DEBUG=true       # ← Validated as boolean

# ==========================================
# Auth0 JWT Validation
# ==========================================
# Pydantic Settings: Maps to Auth0Settings
# Domain format validated (no http://)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=your-api-identifier

# ==========================================
# Embedding & Chunking Configuration
# ==========================================
# Pydantic Settings: Maps to EmbeddingSettings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Validated: Must be one of these exact values
CHUNKING_STRATEGY=recursive_split  # recursive_split | semantic_chunking | hybrid_chunking

# Validated: 100 <= CHUNK_SIZE <= 2048
CHUNK_SIZE=512

# Validated: 0 <= CHUNK_OVERLAP < CHUNK_SIZE
CHUNK_OVERLAP=50

# ==========================================
# Feature Flags (RAG Strategy)
# ==========================================
# Pydantic Settings: Maps to FeatureFlagSettings
FEATURE_SEMANTIC_CHUNKING=false  # ← Validated as boolean
FEATURE_RERANKING=false          # ← Validated as boolean
FEATURE_RERANK_MULTIPLIER=3      # ← Validated: 1 <= value <= 10

# ==========================================
# Reranking Configuration
# ==========================================
# Pydantic Settings: Maps to RerankSettings
# Validated: Must be one of these exact values
RERANK_STRATEGY=combined  # similarity | quality | hybrid | mmr | combined

# Validated: 0.0 <= value <= 1.0
RERANK_QUALITY_WEIGHT=0.2
RERANK_ALPHA=0.7
RERANK_LAMBDA=0.5

# Validated: >= 1
RERANK_MAX_CHUNKS_PER_DOC=2