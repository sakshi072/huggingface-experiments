# ==========================================
# PostgreSQL Configuration
# ==========================================
# Default port is 5432. Use 'localhost' for local dev or 'db' if using Docker.
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==========================================
# MinIO Configuration (Object Storage)
# ==========================================
# MINIO_ROOT_USER/PASSWORD are the credentials for the dashboard.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=document-storage
MINIO_SECURE=false

# ==========================================
# App Settings
# ==========================================
# ENV: development, staging, or production
ENV=development
DEBUG=True

# ==========================================
# Auth0 JWT Validation
# ==========================================
# Example: dev-12345.us.auth0.com
AUTH0_DOMAIN=your-tenant.auth0.com
# Example: https://api.yourdomain.com
AUTH0_AUDIENCE=your-api-identifier

# ==========================================
# Embedding & Chunking Configuration
# ==========================================
# Model for generating embeddings (sentence-transformers format)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking strategy: recursive_split, semantic_chunking, or hybrid_chunking
CHUNKING_STRATEGY=recursive_split

# Chunk size in characters
CHUNK_SIZE=512

# Overlap between chunks in characters
CHUNK_OVERLAP=50

# ==========================================
# Feature Flags (RAG Strategy)
# ==========================================
# Use semantic chunking for smarter splitting based on meaning
FEATURE_SEMANTIC_CHUNKING=false

# Enable a reranking node to improve precision after vector search
FEATURE_RERANKING=false

# How many extra results to pull from vector DB to feed the reranker
FEATURE_RERANK_MULTIPLIER=3

# ==========================================
# Reranking Configuration
# ==========================================
# Reranking strategy: similarity, quality, hybrid, mmr, combined
RERANK_STRATEGY=combined

# Quality boost weight (0.0 to 1.0) - how much quality score affects ranking
RERANK_QUALITY_WEIGHT=0.2

# Alpha for hybrid scoring (0.0 to 1.0) - balance between dense (vector) and sparse (BM25)
RERANK_ALPHA=0.7

# Lambda for MMR diversity (0.0 to 1.0) - balance between relevance and diversity
RERANK_LAMBDA=0.5

# Max chunks per document in results (promotes diversity)
RERANK_MAX_CHUNKS_PER_DOC=2